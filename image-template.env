# Shared defaults for the Justfile and local image builds.
# GitHub Actions overrides IMAGE_NAME, REPO_ORGANIZATION, BASE_IMAGE, and
# BUILD_SCRIPT per matrix entry so the three published variants keep their
# existing names.

IMAGE_NAME=ilm-os
REPO_IMAGE_NAME=ilm-os
REPO_ORGANIZATION="pervezfunctor"
IMAGE_DESC="My Customized Universal Blue Image"
IMAGE_KEYWORDS="bootc,ublue,universal-blue"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG=latest
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
